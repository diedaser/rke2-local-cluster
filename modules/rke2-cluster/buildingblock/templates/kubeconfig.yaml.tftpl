apiVersion: v1
kind: Config
clusters:
  - name: ${cluster_name}
    cluster:
      server: ${api_server_url}
      certificate-authority-data: ${base64encode(ca_cert_pem)}
users:
  - name: ${cluster_name}-admin
    user:
      client-certificate-data: ${base64encode(client_cert_pem)}
      client-key-data: ${base64encode(client_key_pem)}
contexts:
  - name: ${cluster_name}
    context:
      cluster: ${cluster_name}
      user: ${cluster_name}-admin
current-context: ${cluster_name}
