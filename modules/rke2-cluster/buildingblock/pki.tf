# Cluster PKI generated by OpenTofu (ADR-003). cloud-init writes the CA set
# into /var/lib/rancher/rke2/server/tls/ on the first server before RKE2
# starts, so RKE2 uses these CAs instead of generating its own. Joining servers
# receive them from the cluster datastore.
#
# CA private keys live in state: state encryption is mandatory (ADR-004).
# Changes here require an ADR update (CONTRIBUTING.md rule 6).

locals {
  # name => path relative to /var/lib/rancher/rke2/server/tls
  cluster_cas = {
    "server-ca"         = "server-ca"
    "client-ca"         = "client-ca"
    "request-header-ca" = "request-header-ca"
    "etcd-server-ca"    = "etcd/server-ca"
    "etcd-peer-ca"      = "etcd/peer-ca"
  }

  ca_validity_hours = 87600 # 10 years, see docs/operations.md for rotation
}

resource "tls_private_key" "ca" {
  for_each = local.cluster_cas

  algorithm   = "ECDSA"
  ecdsa_curve = "P256"
}

resource "tls_self_signed_cert" "ca" {
  for_each = local.cluster_cas

  private_key_pem       = tls_private_key.ca[each.key].private_key_pem
  is_ca_certificate     = true
  validity_period_hours = local.ca_validity_hours

  subject {
    common_name  = "rke2-${each.key}@${local.prefix}"
    organization = "meshstack-${var.workspace_identifier}"
  }

  allowed_uses = [
    "cert_signing",
    "crl_signing",
    "digital_signature",
    "key_encipherment",
  ]

  lifecycle {
    # Never rotate a CA by accident; rotation is a manual procedure.
    ignore_changes = [subject, allowed_uses, validity_period_hours]
  }
}

# Signs service account tokens. Has no certificate.
resource "tls_private_key" "service_account" {
  algorithm = "RSA"
  rsa_bits  = 2048
}

# --- Admin client certificate --------------------------------------------------

resource "tls_private_key" "admin" {
  algorithm   = "ECDSA"
  ecdsa_curve = "P256"
}

resource "tls_cert_request" "admin" {
  private_key_pem = tls_private_key.admin.private_key_pem

  subject {
    common_name  = "meshstack-admin"
    organization = "system:masters"
  }
}

resource "tls_locally_signed_cert" "admin" {
  cert_request_pem   = tls_cert_request.admin.cert_request_pem
  ca_private_key_pem = tls_private_key.ca["client-ca"].private_key_pem
  ca_cert_pem        = tls_self_signed_cert.ca["client-ca"].cert_pem

  validity_period_hours = var.admin_cert_validity_hours
  # Renew on the first apply within the last quarter of the validity, max. 30 days.
  early_renewal_hours = min(720, floor(var.admin_cert_validity_hours / 4))

  allowed_uses = [
    "client_auth",
    "digital_signature",
    "key_encipherment",
  ]
}
