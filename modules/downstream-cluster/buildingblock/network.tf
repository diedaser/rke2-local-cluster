# Nodes go into the management cluster's VPC and private subnets (ADR-015),
# passed on by the `rancher` parent. No VPC, NAT or peering of its own: the
# nodes reach Rancher (443) and the internet through the management NAT
# gateway, whose IP Rancher's public NLB already admits.
#
# Isolation inside the shared VPC comes from security groups:
# - this cluster's node group admits only its own members;
# - the management node groups admit only management members and the NLBs;
# - the management internal NLB admits 6443/9345 only from the management
#   nodes (rke2-cluster, lb_internal_from_nodes), not from the VPC CIDR.

data "aws_subnet" "node" {
  for_each = var.mgmt_private_subnet_ids

  id = each.value

  lifecycle {
    postcondition {
      # A subnet from another VPC would put nodes outside the management
      # network's security boundary. The AZ keys are generated by
      # rke2-cluster (private_subnet_ids), so only the VPC is checked.
      condition     = self.vpc_id == var.mgmt_vpc_id
      error_message = "Subnet ${each.value} is not in VPC ${var.mgmt_vpc_id}. mgmt_vpc_id and mgmt_private_subnet_ids must come from the same rke2-cluster."
    }
  }
}

locals {
  azs = sort(keys(var.mgmt_private_subnet_ids))
}

# Node security group. Passed to the node driver by name with
# security_group_readonly, so Rancher adds no rules (no SSH, nothing public).
# All traffic between this cluster's nodes is allowed (RKE2 needs 6443, 9345,
# 10250, 2379-2381, 8472/udp, 9099 and NodePorts between nodes); nothing else
# may connect in, including the management nodes.
resource "aws_security_group" "nodes" {
  name        = "${local.prefix}-nodes"
  description = "Nodes of downstream cluster ${local.rancher_cluster_name}"
  vpc_id      = var.mgmt_vpc_id
  tags        = { Name = "${local.prefix}-nodes" }

  lifecycle {
    precondition {
      condition     = data.aws_caller_identity.current.account_id == var.aws_account_id
      error_message = "The AWS credentials belong to account ${data.aws_caller_identity.current.account_id}, but the meshStack tenant is ${var.aws_account_id} (see ADR-013)."
    }
  }
}

resource "aws_vpc_security_group_ingress_rule" "nodes_self" {
  security_group_id            = aws_security_group.nodes.id
  description                  = "All traffic between the cluster's nodes"
  referenced_security_group_id = aws_security_group.nodes.id
  ip_protocol                  = "-1"
}

# Egress to Rancher (443 via the management NAT), registries, the RKE2 installer.
#trivy:ignore:AVD-AWS-0104
resource "aws_vpc_security_group_egress_rule" "nodes_all" {
  security_group_id = aws_security_group.nodes.id
  description       = "Egress via the management NAT gateway"
  cidr_ipv4         = "0.0.0.0/0"
  ip_protocol       = "-1"
}
