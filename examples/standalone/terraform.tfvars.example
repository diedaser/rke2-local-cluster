# Copy to terraform.tfvars (git-ignored) and adjust.
# Export credentials and the passphrase in your shell instead of writing them here:
#   export AWS_PROFILE=<dev-profile> AWS_REGION=eu-central-1   # or AWS_ACCESS_KEY_ID/...
#   export TF_VAR_state_encryption_passphrase=...
#
# Current Ubuntu 24.04 AMI for the region:
#   aws ssm get-parameter --name /aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id --query Parameter.Value --output text

aws_account_id       = "123456789012"
cluster_name         = "dev-mgmt"
server_count         = "1"
server_instance_type = "m7i.xlarge"
ami_id               = "ami-0123456789abcdef0"
# Must contain the egress IP of the machine running tofu (curl https://checkip.amazonaws.com).
# Otherwise data.http.api_readyz retries for 20 minutes and then fails. The value
# below is a documentation placeholder and never matches.
api_allowed_cidrs    = ["198.51.100.10/32"]

# Must resolve to the lb_dns_name output from the machine running tofu, for apply
# AND destroy (data.http.rancher_ping is re-read on every plan). Without a real
# DNS record, add "<NLB IP> <hostname>" to /etc/hosts after phase one:
#   getent ahostsv4 "$(tofu output -raw lb_dns_name)"
rancher_hostname     = "rancher.dev.example.com"
